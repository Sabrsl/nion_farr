# Variables d'environnement requises pour le projet NionFar

# Environnement
NODE_ENV=production
PORT=3001

# Render
IS_RENDER=true

# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# URL de l'application
API_URL=https://nionfar-backend.onrender.com
APP_URL=https://nionfar-backend.onrender.com
BACKEND_URL=https://nionfar-backend.onrender.com
FRONTEND_URL=https://nion-farr.vercel.app

# CORS
CORS_ALLOWED_ORIGINS=https://nion-farr.vercel.app,http://localhost:3000

# JWT
JWT_SECRET=your_secure_jwt_secret_here
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_secure_refresh_token_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# Email
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=user@example.com
MAIL_PASSWORD=your_email_password
MAIL_FROM=noreply@nionfar.com

# Optimisation
MEMORY_OPTIMIZED=true
