# Variables d'environnement requises pour le projet NionFar

# Application
NODE_ENV=development
PORT=8080
API_PREFIX=api
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Database (MongoDB)
MONGODB_URI=mongodb+srv://username:password@clusterexample.mongodb.net/database?retryWrites=true&w=majority
DB_AUTH_SOURCE=admin

# JWT
JWT_SECRET=your_secure_jwt_secret_here
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your_secure_refresh_token_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# Memory management
NODE_OPTIONS=--max-old-space-size=256
LOG_LEVEL=info

# Email (Resend)
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_SECURE=true
MAIL_USER=resend
MAIL_PASSWORD=your_resend_api_key_here
MAIL_FROM=example@yourdomain.com
MAIL_FROM_NAME=YourAppName
RESEND_API_KEY=your_resend_api_key_here
USE_RESEND=true

# Render
IS_RENDER=true

# URL de l'application
API_URL=https://nionfar-backend.onrender.com
BACKEND_URL=https://nionfar-backend.onrender.com

# Optimisation
MEMORY_OPTIMIZED=true
