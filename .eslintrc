{
  "root": true,
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "env": {
    "browser": true,
    "node": true,
    "es2022": true
  },
  "extends": ["eslint:recommended"],
  "ignorePatterns": [
    "dist",
    "node_modules",
    "**/*.min.js",
    "frontend/_archive/**/*"
  ],
  "overrides": [
    {
      "files": ["backend/*.js", "backend/create-*.js", "backend/check-*.js", "backend/test-*.js"],
      "rules": {
        "no-unused-vars": "off"
      }
    },
    {
      "files": ["frontend/utils/*.js", "frontend/public/*.js", "frontend/src/*.js"],
      "rules": {
        "no-unused-vars": "off"
      }
    },
    {
      "files": ["backend/**/*.ts"],
      "parser": "@typescript-eslint/parser",
      "parserOptions": {
        "project": "./backend/tsconfig.json"
      }
    },
    {
      "files": ["frontend/**/*.ts", "frontend/**/*.tsx"],
      "parser": "@typescript-eslint/parser",
      "parserOptions": {
        "project": "./frontend/tsconfig.json"
      }
    },
    {
      "files": ["mocks/**/*.ts", "src/**/*.ts", "types/**/*.ts"],
      "parser": "@typescript-eslint/parser",
      "parserOptions": {
        "project": "./tsconfig.json"
      }
    }
  ]
} 