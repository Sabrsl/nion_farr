{
  "name": "nionfar",
  "version": "0.1.0",
  "description": "NionFar.sn - Plateforme de services freelance au Sénégal",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "frontend": "cd frontend && npm run dev",
    "backend": "cd backend && npm run start:dev",
    "dev:all": "concurrently \"npm run frontend\" \"npm run backend\"",
    "dev:docker": "docker-compose up",
    "dev:build": "docker-compose up --build",
    "stop": "docker-compose down",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install",
    "lint": "eslint \"frontend/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\" \"mocks/**/*.{ts,tsx}\"",
    "vercel-build": "node vercel-build.js && next build && node vercel-post-build.js",
    "clean-build": "rimraf tsconfig.tsbuildinfo backend/dist frontend/.next && cd backend && npm run build && cd .. && cd frontend && npm run build",
    "prepare": "husky",
    "test:railway-build": "cd backend && npm run build:railway && echo \"✅ Build Railway validé\" || echo \"❌ Build Railway échoué\"",
    "pre-push": "node scripts/pre-push-check.js",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "author": "NionFar Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.0.1",
    "@mui/material": "^7.0.1",
    "@mui/x-date-pickers": "^7.28.3",
    "@sentry/node": "^9.11.0",
    "@tsparticles/engine": "^3.8.1",
    "@tsparticles/react": "^3.0.0",
    "@tsparticles/slim": "^3.8.1",
    "@types/authenticator": "^1.1.4",
    "@types/mongodb": "^4.0.6",
    "@types/nodemailer": "^6.4.17",
    "authenticator": "^1.1.5",
    "axios": "^1.8.4",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.6.3",
    "graphql": "^16.10.0",
    "mongodb": "^6.15.0",
    "msw": "^2.0.0",
    "next": "^13.4.2",
    "next-auth": "^4.22.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.10.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "react-toastify": "^9.1.3",
    "recharts": "^2.15.2",
    "tailwind-merge": "^3.2.0"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.8.0",
    "@tailwindcss/nesting": "^0.0.0-insiders.565cd3e",
    "@tailwindcss/postcss": "^4.1.3",
    "@types/react": "19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.24.0",
    "eslint-config-next": "^15.2.4",
    "husky": "^9.1.7",
    "postcss": "^8.5.3",
    "postcss-import": "^16.1.0",
    "postcss-nesting": "^13.0.1",
    "rimraf": "^5.0.5",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.5.3"
  }
}
