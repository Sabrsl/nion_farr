{
  "version": 2,
  "outputDirectory": "nionfar/frontend/.next",
  "buildCommand": "cd nionfar/frontend && npm install --legacy-peer-deps && npm run build:force",
  "installCommand": "cd nionfar/frontend && npm install --legacy-peer-deps",
  "framework": "nextjs",
  "env": {
    "NODE_ENV": "production",
    "NEXT_TELEMETRY_DISABLED": "1",
    "NEXT_DISABLE_ESLINT": "1",
    "NEXT_DISABLE_TYPE_CHECKS": "1"
  }
} 