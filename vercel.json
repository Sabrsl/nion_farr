{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run vercel-build",
  "installCommand": "npm install",
  "outputDirectory": "frontend/.next",
  "rootDirectory": "frontend",
  "routes": [
    {
      "src": "/api/:path*",
      "dest": "https://nionfar-backend.onrender.com/api/:path*"
    }
  ]
} 