# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=nionfar
DB_SYNC=true

# MongoDB
MONGODB_URI=mongodb://localhost:27017/nionfar

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=7d

# 2FA
TWO_FACTOR_AUTHENTICATION_APP_NAME=NionFar

# Email
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=user@example.com
MAIL_PASSWORD=password
MAIL_FROM=noreply@nionfar.sn

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Payment (Wave)
WAVE_API_KEY=your_wave_api_key
WAVE_API_SECRET=your_wave_api_secret
WAVE_API_URL=https://api.wave.com

# Payment (Orange Money)
ORANGE_MONEY_API_KEY=your_orange_money_api_key
ORANGE_MONEY_API_SECRET=your_orange_money_api_secret
ORANGE_MONEY_API_URL=https://api.orange.com

# Payment (Free Money)
FREE_MONEY_API_KEY=your_free_money_api_key
FREE_MONEY_API_SECRET=your_free_money_api_secret
FREE_MONEY_API_URL=https://api.free.sn 