{
  "version": 2,
  "buildCommand": "NODE_OPTIONS='--max_old_space_size=4096' npm install --legacy-peer-deps && NEXT_DISABLE_ESLINT=1 NODE_ENV=production npm run build",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://nionfar-backend.onrender.com/api/:path*"
    }
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://nionfar-backend.onrender.com/api",
    "NEXT_PUBLIC_APP_URL": "https://nionfar.vercel.app",
    "NEXT_PUBLIC_ENVIRONMENT": "production",
    "NEXT_DISABLE_ESLINT": "1",
    "NODE_ENV": "production"
  }
} 