# Configuration de production
NEXT_PUBLIC_API_URL=https://nionfar-backend.onrender.com/api
NEXT_PUBLIC_APP_URL=https://nionfar.vercel.app
NEXT_PUBLIC_ENVIRONMENT=production

# CDN Configuration
NEXT_PUBLIC_CDN_URL=https://nionfar-frontend.onrender.com

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true

# Security
NEXT_PUBLIC_CSP_ENABLED=true
NEXT_PUBLIC_HSTS_ENABLED=true

# Ne pas inclure de clés API sensibles ici car le préfixe NEXT_PUBLIC_ rend ces variables
# visibles dans le navigateur. Utilisez plutôt des variables sans ce préfixe.
# Les clés sensibles suivantes doivent être configurées dans l'interface Vercel et non ici
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
NEXT_DISABLE_ESLINT=1
NEXT_DISABLE_TYPE_CHECKS=1

# Authentication
NEXTAUTH_URL=https://nionfar.vercel.app
# NEXTAUTH_SECRET=your_nextauth_secret_here_change_this_in_production

