{
  "name": "nionfar-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:production": "set NODE_ENV=production&& set NEXT_DISABLE_ESLINT=1&& next build",
    "build:prod": "set NODE_ENV=production&& next build --no-lint",
    "build:force": "set NODE_ENV=production&& set NEXT_DISABLE_ESLINT=1&& set NEXT_DISABLE_TYPE_CHECKS=1&& next build --no-lint",
    "prod": "set NODE_ENV=production&& set NEXT_TELEMETRY_DISABLED=1&& next dev",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.14.3",
    "@mui/material": "^5.14.5",
    "@tanstack/react-query": "^5.12.2",
    "axios": "^1.6.2",
    "bcryptjs": "^3.0.2",
    "date-fns": "^2.30.0",
    "framer-motion": "^12.6.3",
    "mongodb": "^6.15.0",
    "next": "^14.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.12.0",
    "resend": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.39",
    "@types/react-dom": "^18.2.17",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.54.0",
    "eslint-config-next": "^14.0.3",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.3.2"
  }
}
