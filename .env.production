# Configuration pour déploiement Render
NODE_ENV=production
IS_RENDER=true

# URLs et ports
PORT=3001
APP_URL=https://nionfar-backend.onrender.com
FRONTEND_URL=https://nion-farr.vercel.app
API_PREFIX=api

# CORS
CORS_ALLOWED_ORIGINS=https://nion-farr.vercel.app,https://nionfar.vercel.app,http://localhost:3000

# MongoDB
MONGODB_URI=mongodb+srv://username:${MONGODB_PASSWORD}@cluster.mongodb.net/database?retryWrites=true&w=majority

# JWT
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=${JWT_REFRESH_SECRET}
JWT_REFRESH_EXPIRES_IN=7d

# Email (Resend)
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_SECURE=true
MAIL_USER=resend
MAIL_PASSWORD=${RESEND_API_KEY}
MAIL_FROM=onboarding@resend.dev
MAIL_FROM_NAME=NionFar
RESEND_API_KEY=${RESEND_API_KEY}

# Options de gestion de la mémoire
MEMORY_OPTIMIZED=true
NODE_OPTIONS="--max-old-space-size=1024"
MAX_USERS_IN_MEMORY=100
MAX_TOKENS_IN_MEMORY=200
MEMORY_CHECK_INTERVAL_MS=60000
HEAP_WARNING_THRESHOLD=85
HEAP_CRITICAL_THRESHOLD=90

# Options de sécurité
PASSWORD_SALT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# 2FA
TWO_FACTOR_AUTHENTICATION_APP_NAME=NionFar

# Options de performance
ENABLE_PERFORMANCE_MONITORING=true
MEMORY_MONITORING_INTERVAL=1800000
LOG_LEVEL=info 