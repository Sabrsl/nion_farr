{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "dist/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/health",
      "dest": "/api/index.js"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "API_PREFIX": "api",
    "APP_URL": "https://nion-farr-backend.vercel.app",
    "FRONTEND_URL": "https://nion-farr.vercel.app",
    "CORS_ALLOWED_ORIGINS": "https://nion-farr.vercel.app,https://www.nion-farr.vercel.app",
    "VERCEL": "1"
  },
  "regions": ["cdg1"],
  "github": {
    "silent": true
  }
} 