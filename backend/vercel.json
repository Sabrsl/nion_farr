{
  "version": 2,
  "git": {
    "deploymentEnabled": {
      "main": false,
      "develop": false
    }
  },
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm install",
  "framework": null,
  "outputDirectory": "dist",
  "functions": {
    "api/**/*": {
      "runtime": "nodejs16"
    },
    "**/*.js": {
      "runtime": "nodejs16"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "env": {
    "NODE_ENV": "production",
    "APP_URL": "https://nion-farr-backend.vercel.app",
    "FRONTEND_URL": "https://nion-farr.vercel.app",
    "PORT": "3001",
    "CORS_ALLOWED_ORIGINS": "https://nion-farr.vercel.app,https://nion-farr-backend.vercel.app",
    "NEXT_DISABLE_ESLINT": "1"
  }
} 