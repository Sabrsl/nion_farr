{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.js"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "APP_URL": "https://nion-farr-backend.vercel.app",
    "FRONTEND_URL": "https://nion-farr.vercel.app",
    "PORT": "3001",
    "CORS_ALLOWED_ORIGINS": "https://nion-farr.vercel.app,https://nion-farr-backend.vercel.app,http://localhost:3000"
  }
} 