{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "./Dockerfile.railway"
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "startCommand": "./start.sh",
    "healthcheckPath": "/",
    "healthcheckTimeout": 45,
    "healthcheckInterval": 30,
    "numReplicas": 1
  }
} 