# Configuration principale
NODE_ENV=production
PORT=3000
API_PREFIX=api
APP_URL=https://nionfar.up.railway.app
FRONTEND_URL=https://nion-farr.vercel.app
CORS_ALLOWED_ORIGINS=https://nion-farr.vercel.app

# Indicateurs de plateforme
RAILWAY_DEPLOYMENT=true
IS_RENDER=false

# Configuration mémoire
MEMORY_OPTIMIZED=true
NODE_OPTIONS="--max-old-space-size=256"
HEAP_WARNING_THRESHOLD=80
HEAP_CRITICAL_THRESHOLD=90
MAX_USERS_IN_MEMORY=100
DISABLE_USER_SYNC=true

# Optimisations de performance
LOG_LEVEL=error

# Ces valeurs sont remplacées par les variables d'environnement Railway
# Ne pas mettre de vrais secrets ici, ils doivent être définis dans l'interface Railway
JWT_SECRET=placeholder_replaced_by_railway_env
JWT_REFRESH_SECRET=placeholder_replaced_by_railway_env
MONGODB_URI=placeholder_replaced_by_railway_env

# Database (MongoDB)
DB_AUTH_SOURCE=admin

# JWT
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Configuration Railway
RAILWAY_PROJECT_ID=f4495249-f2cf-420b-8d3e-ecbebeffc37d
RAILWAY_SERVICE_ID=2bfc26f1-3c54-4aa8-9ff6-234648de12aa
RAILWAY_PUBLIC_DOMAIN=nionfar.up.railway.app
RAILWAY_PROJECT_NAME=nionfar
RAILWAY_ENVIRONMENT_NAME=production
RAILWAY_SERVICE_NAME=nion_farr
RAILWAY_ENVIRONMENT_ID=f8dd8f53-6416-45c9-ab3e-07561fbb8923

