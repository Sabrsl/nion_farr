# Environnement (définit le mode)
NODE_ENV=production

# Configuration du serveur
PORT=3000
API_PREFIX=api
APP_URL=https://nionfar.up.railway.app
FRONTEND_URL=https://nionfar.sn
CORS_ALLOWED_ORIGINS=https://nionfar.sn,https://www.nionfar.sn

# Clés secrètes (à remplacer par vos propres valeurs)
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# Configuration mémoire
MEMORY_OPTIMIZED=true
NODE_OPTIONS=--max-old-space-size=256

# Désactive les fonctionnalités intensives en mémoire
DISABLE_STATS_CACHE=true
DISABLE_USER_SYNC=true

# Railway
RAILWAY_DEPLOYMENT=true
IS_RENDER=false

# Monitoring (optionnel)
SENTRY_DSN=your_sentry_dsn_here

# Emails (optionnel)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your_smtp_password_here
EMAIL_FROM=noreply@nionfar.sn

# Authentification 2FA (optionnel)
TWO_FACTOR_AUTHENTICATION_APP_NAME=NionFar

# Database (MongoDB)
DB_AUTH_SOURCE=admin

# JWT
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Configuration Railway
RAILWAY_PROJECT_ID=your_project_id
RAILWAY_SERVICE_ID=your_service_id
RAILWAY_PUBLIC_DOMAIN=your_app.up.railway.app
RAILWAY_PROJECT_NAME=your_project_name
RAILWAY_ENVIRONMENT_NAME=production
RAILWAY_SERVICE_NAME=your_service_name
RAILWAY_ENVIRONMENT_ID=your_environment_id

# Email (Resend)
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_SECURE=true
MAIL_USER=resend
MAIL_PASSWORD=your_mail_password
MAIL_FROM=your_email@example.com
MAIL_FROM_NAME=YourAppName
RESEND_API_KEY=your_resend_api_key 