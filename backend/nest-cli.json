{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "main",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "assets": ["**/*.hbs", "assets/**/*"],
    "watchAssets": true,
    "builder": "tsc",
    "typeCheck": true,
    "tsConfigPath": "tsconfig.build.json",
    "plugins": [{
      "name": "@nestjs/swagger",
      "options": {
        "dtoFileNameSuffix": [".dto.ts", ".entity.ts"],
        "controllerFileNameSuffix": [".controller.ts"]
      }
    }]
  }
} 