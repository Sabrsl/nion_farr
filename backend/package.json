{
  "name": "nionfar-backend",
  "version": "1.0.0",
  "description": "Backend for Nionfar platform",
  "author": "NionFar Team",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "build:verbose": "nest build --verbose",
    "build:debug": "echo '📋 Debug du build...' && rimraf dist && mkdir -p dist && nest build --verbose && echo '📋 Contenu du répertoire dist:' && ls -la dist/",
    "build:railway": "rimraf dist && nest build && node scripts/check-dist.js",
    "build:clean": "rimraf dist && nest build",
    "postbuild": "node scripts/check-dist.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "start:render": "cross-env NODE_OPTIONS=\"--max-old-space-size=128\" npm run build && cross-env NODE_OPTIONS=\"--max-old-space-size=128\" cross-env MEMORY_OPTIMIZED=true node dist/main.js",
    "start:low-memory": "cross-env NODE_OPTIONS=\"--max-old-space-size=128\" cross-env MEMORY_OPTIMIZED=true node dist/main.js",
    "start:railway": "cross-env NODE_OPTIONS=\"--max-old-space-size=256\" cross-env MEMORY_OPTIMIZED=true RAILWAY_DEPLOYMENT=true PORT=8080 node dist/main.js || (sleep 5 && node server-simple.js)",
    "start:railway:simple": "cross-env NODE_ENV=production RAILWAY_DEPLOYMENT=true IS_RENDER=false MEMORY_OPTIMIZED=true PORT=8080 node server-simple.js",
    "start:backup": "node server.js",
    "verify:railway": "node scripts/verify-railway-start.js",
    "prepare:railway": "node scripts/prepare-railway.js",
    "validate:railway": "node scripts/validate-railway.js",
    "check:railway": "node scripts/check-deployment.js",
    "check:railway-env": "node scripts/check-railway-env.js",
    "disable:render": "node scripts/check-railway-env.js",
    "export:render-env": "node -e \"console.log(require('fs').readFileSync('.env', 'utf8').split('\\n').filter(line => !line.startsWith('#') && line.trim()).join('\\n'))\" > render-env-export.txt",
    "backup:before-migration": "npm run export:render-env && node src/scripts/backup.ts",
    "start:pm2": "pm2 start ecosystem.config.js --env production",
    "stop:pm2": "pm2 stop ecosystem.config.js",
    "restart:pm2": "pm2 restart ecosystem.config.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed": "ts-node -r tsconfig-paths/register src/seed.ts",
    "init-server": "ts-node -r tsconfig-paths/register src/scripts/init-server.ts",
    "typeorm:migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "generate-db": "ts-node src/generate-database-structure.ts",
    "audit": "ts-node -r tsconfig-paths/register src/scripts/audit.ts",
    "setup-cron": "ts-node -r tsconfig-paths/register src/scripts/setup-cron.ts",
    "backup": "ts-node -r tsconfig-paths/register src/scripts/backup.ts",
    "migration:create": "ts-node -r tsconfig-paths/register src/scripts/create-migration.ts",
    "migration:run": "ts-node -r tsconfig-paths/register src/scripts/run-migration.ts",
    "migration:status": "ts-node -r tsconfig-paths/register src/scripts/migration-status.ts",
    "test:jwt": "ts-node src/scripts/test-jwt.ts",
    "generate:secrets": "ts-node src/scripts/generate-secrets.ts",
    "check:dist": "node src/check-dist.js",
    "monitor:memory": "node src/scripts/memory-monitor.js"
  },
  "dependencies": {
    "@nestjs/bull": "^10.0.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/mongoose": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/swagger": "^7.0.0",
    "@nestjs/throttler": "^5.1.1",
    "@nestjs/typeorm": "^10.0.0",
    "@sentry/node": "^7.0.0",
    "@sentry/profiling-node": "^1.0.0",
    "axios": "^1.8.4",
    "bcrypt": "^5.1.0",
    "bcryptjs": "^3.0.2",
    "bull": "^4.12.2",
    "bullmq": "^5.1.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "cron": "^2.3.0",
    "cross-env": "^7.0.3",
    "express": "^4.18.3",
    "express-rate-limit": "^7.5.0",
    "helmet": "^7.2.0",
    "joi": "^17.13.3",
    "mongoose": "^7.0.0",
    "nest-access-control": "^3.1.0",
    "nest-winston": "^1.7.0",
    "nodemailer": "^6.10.0",
    "otplib": "^12.0.1",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pm2": "^5.3.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.0",
    "winston": "^3.8.2",
    "zod": "^3.24.2",
    "zod-validation-error": "^3.4.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.3.1",
    "@types/passport-jwt": "^3.0.8",
    "@types/passport-local": "^1.0.35",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "rimraf": "^3.0.2",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "4.9.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "resolutions": {
    "typescript": "4.9.5"
  }
}
