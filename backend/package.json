{
  "name": "nionfar-backend",
  "version": "1.0.0",
  "description": "Backend for Nionfar platform",
  "author": "NionFar Team",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/src/main.js",
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" nest build",
    "build:verbose": "npm run clean && cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" nest build --verbose",
    "build:debug": "echo \"📋 Debug du build...\" && npm run clean && cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" nest build --verbose",
    "build:clean": "npm run clean && cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" nest build",
    "build:vercel": "rimraf dist && cross-env NODE_OPTIONS=\"--max-old-space-size=1024\" nest build && node prepare-vercel.js",
    "vercel-build": "rimraf dist && cross-env NODE_OPTIONS=\"--max-old-space-size=1024\" nest build && node prepare-vercel.js",
    "prepare:vercel": "node prepare-vercel.js",
    "postbuild": "node scripts/check-dist.js && npm run check:main-js",
    "clean:source-js": "node scripts/clean-source-js.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" nest start",
    "start:dev": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" nest start --watch",
    "start:debug": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" nest start --debug --watch",
    "start:prod": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" node dist/src/main.js",
    "start:prod:vercel": "cross-env NODE_OPTIONS=\"--max-old-space-size=1024\" cross-env MEMORY_OPTIMIZED=true node dist/src/main.js",
    "start:low-memory": "cross-env NODE_OPTIONS=\"--max-old-space-size=1024\" cross-env MEMORY_OPTIMIZED=true node dist/src/main.js",
    "start:backup": "node server.js",
    "export:env": "node -e \"console.log(require('fs').readFileSync('.env', 'utf8').split('\\n').filter(line => !line.startsWith('#') && line.trim()).join('\\n'))\" > env-export.txt",
    "backup:before-migration": "npm run export:env && node src/scripts/backup.ts",
    "start:pm2": "pm2 start ecosystem.config.js --env production",
    "stop:pm2": "pm2 stop ecosystem.config.js",
    "restart:pm2": "pm2 restart ecosystem.config.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:mongodb": "mocha tests/mongodb-schema-validation.test.js --timeout 10000",
    "seed": "ts-node -r tsconfig-paths/register src/seed.ts",
    "init-server": "ts-node -r tsconfig-paths/register src/scripts/init-server.ts",
    "typeorm:migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "generate-db": "ts-node src/generate-database-structure.ts",
    "audit": "ts-node -r tsconfig-paths/register src/scripts/audit.ts",
    "setup-cron": "ts-node -r tsconfig-paths/register src/scripts/setup-cron.ts",
    "backup": "ts-node -r tsconfig-paths/register src/scripts/backup.ts",
    "migration:create": "ts-node -r tsconfig-paths/register src/scripts/create-migration.ts",
    "migration:run": "ts-node -r tsconfig-paths/register src/scripts/run-migration.ts",
    "migration:status": "ts-node -r tsconfig-paths/register src/scripts/migration-status.ts",
    "test:jwt": "ts-node src/scripts/test-jwt.ts",
    "generate:secrets": "ts-node src/scripts/generate-secrets.ts",
    "check:dist": "node scripts/check-dist.js",
    "monitor:memory": "node src/scripts/memory-monitor.js",
    "build:fixed": "rimraf dist && tsc -p tsconfig.build.json && cp -r src/**/*.js dist/ && echo 'Build terminé avec copy manuel des fichiers JS'",
    "check:main-js": "node -e \"const fs=require('fs');const path=require('path');const mainJsPath=path.join(__dirname,'dist','src','main.js');const distMainJsPath=path.join(__dirname,'dist','main.js');const srcMainJsPath=path.join(__dirname,'src','main.js');if(!fs.existsSync(mainJsPath)){console.log('⚠️ main.js manquant dans dist/src/');if(fs.existsSync(srcMainJsPath)){console.log('⚠️ Le dossier dist/src/ doit être créé manuellement');if(!fs.existsSync(path.join(__dirname,'dist','src'))){fs.mkdirSync(path.join(__dirname,'dist','src'), { recursive: true });console.log('✅ Dossier dist/src/ créé');}console.log('🔄 Copie du fichier JS source...');fs.copyFileSync(srcMainJsPath,mainJsPath);console.log('✅ main.js copié avec succès');if(!fs.existsSync(distMainJsPath)){console.log('🔄 Copie vers dist/main.js...');fs.copyFileSync(mainJsPath,distMainJsPath);console.log('✅ main.js copié avec succès vers dist/main.js');}}else{console.log('❌ main.js également manquant dans src/, création d\\'un fallback...');require('./src/direct-copy.js');}}else{console.log('✅ main.js existe dans dist/src/');if(!fs.existsSync(distMainJsPath)){console.log('🔄 Copie vers dist/main.js...');fs.copyFileSync(mainJsPath,distMainJsPath);console.log('✅ main.js copié avec succès vers dist/main.js');}}\"",
    "mongodb:audit": "node scripts/audit-mongodb-data.js",
    "mongodb:fix": "node scripts/fix-mongodb-schema.js",
    "mongodb:prepare": "node scripts/prepare-mongodb-for-production.js",
    "mongodb:schedule-audit": "node scripts/schedule-mongodb-audit.js",
    "mongodb:validate": "npm run test:mongodb && npm run mongodb:audit",
    "fix:dist": "node scripts/fix-dist-structure.js",
    "fix:entities": "node scripts/fix-entity-relations.js",
    "fix:missing-entities": "node scripts/fix-missing-entities.js"
  },
  "dependencies": {
    "@nestjs/bull": "^10.0.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^10.0.2",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/throttler": "^5.1.1",
    "@nestjs/typeorm": "^10.0.1",
    "@sentry/node": "^7.108.0",
    "@sentry/profiling-node": "^1.0.0",
    "axios": "^1.8.4",
    "bcrypt": "^5.1.0",
    "bcryptjs": "^3.0.2",
    "bull": "^4.12.2",
    "bullmq": "^5.1.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "cron": "^2.3.0",
    "cross-env": "^7.0.3",
    "express": "^4.18.3",
    "express-rate-limit": "^7.1.5",
    "glob": "^10.3.10",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "mongoose": "^8.1.0",
    "nest-access-control": "^3.1.0",
    "nest-winston": "^1.9.4",
    "nodemailer": "^6.10.0",
    "otplib": "^12.0.1",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pm2": "^5.3.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "serverless-http": "^3.2.0",
    "typeorm": "^0.3.20",
    "winston": "^3.11.0",
    "zod": "^3.24.2",
    "zod-validation-error": "^3.4.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.3.1",
    "@types/passport-jwt": "^3.0.8",
    "@types/passport-local": "^1.0.35",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "rimraf": "^3.0.2",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "4.9.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "resolutions": {
    "typescript": "4.9.5"
  }
}
