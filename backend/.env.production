# Application
NODE_ENV=production
PORT=3000
API_PREFIX=api
APP_URL=https://nionfar-backend.onrender.com
FRONTEND_URL=https://nion-farr.vercel.app
IS_RENDER=true

# Database - MongoDB
MONGODB_URI=mongodb+srv://default:${MONGODB_PASSWORD}@cluster0.qnbszhw.mongodb.net/nionfar?retryWrites=true&w=majority
DB_AUTH_SOURCE=admin
DB_HOST=${DB_HOST}
DB_PORT=27017
DB_USERNAME=${DB_USERNAME}
DB_DATABASE=${DB_DATABASE}
DB_SYNC=false

# JWT
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=${JWT_REFRESH_SECRET}
JWT_REFRESH_EXPIRES_IN=7d

# 2FA
TWO_FACTOR_AUTHENTICATION_APP_NAME=NionFar

# Email
MAIL_HOST=${MAIL_HOST}
MAIL_PORT=${MAIL_PORT}
MAIL_USER=${MAIL_USER}
MAIL_PASSWORD=${MAIL_PASSWORD}
MAIL_FROM=noreply@nion-farr.vercel.app
MAIL_FROM_NAME=NionFar
RESEND_API_KEY=${RESEND_API_KEY}
SENDGRID_API_KEY=${SENDGRID_API_KEY}
USE_RESEND=true

# Options de sécurité supplémentaires
PASSWORD_SALT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Gestion de la mémoire et performances
NODE_OPTIONS="--max-old-space-size=1024"
MAX_USERS_IN_MEMORY=100
MAX_TOKENS_IN_MEMORY=200
MEMORY_CHECK_INTERVAL_MS=60000
HEAP_WARNING_THRESHOLD=85
HEAP_CRITICAL_THRESHOLD=90

# Module de performances
ENABLE_PERFORMANCE_MONITORING=true
MEMORY_MONITORING_INTERVAL=1800000

# Options de logging
LOG_LEVEL=info

# Variables minimales nécessaires au démarrage
MEMORY_OPTIMIZED=true

# CORS
CORS_ALLOWED_ORIGINS=https://nion-farr.vercel.app,https://nionfar.vercel.app

# SMS (Twilio)
TWILIO_ACCOUNT_SID=${TWILIO_ACCOUNT_SID}
TWILIO_AUTH_TOKEN=${TWILIO_AUTH_TOKEN}
TWILIO_PHONE_NUMBER=${TWILIO_PHONE_NUMBER}

# Services de paiement
WAVE_API_KEY=${WAVE_API_KEY}
WAVE_API_SECRET=${WAVE_API_SECRET}
WAVE_API_URL=https://api.wave.com
ORANGE_MONEY_API_KEY=${ORANGE_MONEY_API_KEY}
ORANGE_MONEY_API_SECRET=${ORANGE_MONEY_API_SECRET}
ORANGE_MONEY_API_URL=https://api.orange.com
FREE_MONEY_API_KEY=${FREE_MONEY_API_KEY}
FREE_MONEY_API_SECRET=${FREE_MONEY_API_SECRET}
FREE_MONEY_API_URL=https://api.free.com

# Monitoring (optionnel)
# SENTRY_DSN=votre_sentry_dsn 