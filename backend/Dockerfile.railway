# Dockerfile pour NionFar API
FROM node:18-slim

# Utiliser dumb-init comme init system
RUN apt-get update && apt-get install -y --no-install-recommends dumb-init && rm -rf /var/lib/apt/lists/*

# Définir le répertoire de travail
WORKDIR /app

# Copier package files et installer les dépendances
COPY package*.json ./

# Installation optimisée des dépendances
RUN npm ci --omit=dev --no-audit --ignore-scripts

# Installation des dépendances essentielles
RUN npm install --save reflect-metadata glob winston

# Copier le reste du code source
COPY . .

# Créer dossiers nécessaires
RUN mkdir -p logs dist/common/logger dist/common/interceptors

# Exécuter le build complet avec NestJS CLI
RUN echo "🔨 Lancement du build NestJS..." && \
    npm run build && \
    echo "📋 Exécution du script fix-dist-structure..." && \
    node scripts/fix-dist-structure.js && \
    echo "📋 Vérification et correction des entités..." && \
    node scripts/fix-entity-relations.js

# Vérification du build
RUN echo "📋 Vérification de la structure finale:" && \
    ls -la dist/ && \
    if [ -f "dist/main.js" ]; then \
      echo "✅ main.js trouvé à la racine de dist/" && \
      stat -c %s dist/main.js; \
    else \
      echo "❌ main.js manquant! Impossible de continuer." && \
      exit 1; \
    fi && \
    if [ -f "dist/app.module.js" ]; then \
      echo "✅ app.module.js trouvé" && \
      grep -q "logger" dist/app.module.js && echo "✅ Module logger trouvé dans app.module.js"; \
    else \
      echo "❌ app.module.js manquant!" && \
      exit 1; \
    fi && \
    if [ -f "dist/common/logger/logger.module.js" ]; then \
      echo "✅ logger.module.js trouvé"; \
    else \
      echo "❌ logger.module.js manquant!"; \
      exit 1; \
    fi && \
    if [ -f "dist/common/interceptors/http-exception.interceptor.js" ]; then \
      echo "✅ http-exception.interceptor.js trouvé"; \
    else \
      echo "❌ http-exception.interceptor.js manquant!"; \
      exit 1; \
    fi

# S'assurer que reflect-metadata est correctement chargé
RUN echo '#!/bin/bash\n\necho "🧩 Vérification de reflect-metadata..."\nnode -e "try { require(\"reflect-metadata\"); console.log(\"✅ reflect-metadata chargé avec succès.\"); } catch(e) { console.error(\"❌ Erreur lors du chargement de reflect-metadata:\", e); process.exit(1); }"' > check-reflect.sh && \
    chmod +x check-reflect.sh && \
    ./check-reflect.sh

# Rendre le script de démarrage exécutable
RUN chmod +x ./start-railway.sh

# Exposer les ports
EXPOSE 8080

# Utiliser dumb-init pour gérer correctement les signaux
ENTRYPOINT ["/usr/bin/dumb-init", "--"]

# Commande de démarrage
CMD ["./start-railway.sh"] 