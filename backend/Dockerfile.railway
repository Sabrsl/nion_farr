# Dockerfile pour Railway
FROM node:18-slim

# Utiliser dumb-init comme init system
RUN apt-get update && apt-get install -y --no-install-recommends dumb-init && rm -rf /var/lib/apt/lists/*

# Définir le répertoire de travail
WORKDIR /app

# Copier les fichiers de package.json et installer les dépendances
COPY package.json ./
RUN npm config set package-lock false && \
    npm install --legacy-peer-deps --no-audit --no-optional

# Copier le reste du code source
COPY . .

# Afficher le contenu des dossiers pour débogage
RUN echo "📂 Contenu du dossier source:" && \
    ls -la && \
    echo "📂 Contenu du dossier src:" && \
    ls -la src

# Créer le dossier de logs
RUN mkdir -p logs

# S'assurer que glob est installé pour le script de correction d'importations
RUN npm install glob --save

# Construire l'application en une seule étape
RUN echo "🔨 Lancement du build NestJS..." && \
    npm run build:railway && \
    echo "📋 Structure finale de dist/:" && \
    ls -la dist/ && \
    if [ -f "dist/main.js" ]; then \
      echo "✅ main.js trouvé à la racine de dist/:" && \
      stat -c %s dist/main.js; \
    else \
      echo "❌ main.js toujours manquant! Vérification échouée."; \
      exit 1; \
    fi

# S'assurer que reflect-metadata est correctement chargé
RUN echo '#!/bin/bash\n\necho "🧩 Vérification de reflect-metadata..."\nnode -e "try { require(\"reflect-metadata\"); console.log(\"✅ reflect-metadata chargé avec succès.\"); } catch(e) { console.error(\"❌ Erreur lors du chargement de reflect-metadata:\", e); process.exit(1); }"' > check-reflect.sh && \
    chmod +x check-reflect.sh && \
    ./check-reflect.sh

# Nettoyer les stubs
RUN echo "🧹 Nettoyage des fichiers stubs..." && \
    node scripts/cleanup-stubs.js

# Exécuter le script de correction des importations
RUN echo "🔧 Correction des importations..." && \
    node scripts/fix-imports.js

# Copier le script de démarrage personnalisé
COPY start-railway.sh ./start.sh
RUN chmod +x ./start.sh

# Exposer le port (Railway réaffecte PORT via la variable d'environnement)
EXPOSE 3000 8080

# Utiliser dumb-init pour gérer correctement les signaux
ENTRYPOINT ["/usr/bin/dumb-init", "--"]

# Dernier filet de sécurité AVANT le démarrage
RUN echo "🛠 Vérification finale avant CMD:" && \
    if [ -f "dist/src/main.js" ]; then \
        echo "✅ main.js détecté dans dist/src/ - copie vers dist/" && \
        cp dist/src/main.js dist/main.js; \
    else \
        echo "❌ dist/src/main.js introuvable!"; \
        ls -la dist/src/; \
    fi && \
    echo "📂 Contenu final de dist/: " && ls -la dist/

# Commande de démarrage
CMD ["./start.sh"] 