FROM node:18-slim

WORKDIR /app

# Installer les packages nécessaires
RUN apt-get update && apt-get install -y --no-install-recommends dumb-init && rm -rf /var/lib/apt/lists/*

# Copier package.json sans package-lock.json
COPY package.json ./

# Configuration npm pour éviter les problèmes de verrouillage
RUN npm config set package-lock false && \
    npm install --legacy-peer-deps --no-audit --no-optional

# Copier le code source
COPY . ./

# Debugging: afficher la structure du code source
RUN echo "📂 Contenu du dossier source:" && \
    ls -la && \
    echo "📂 Contenu du dossier src:" && \
    ls -la src

# Créer le dossier de logs
RUN mkdir -p logs

# Exécuter un build complet sans scripts additionnels
RUN echo "🔨 Lancement du build NestJS..." && \
    npm run build:railway

# 👉 Copie manuelle du fichier main.js généré par NestJS
RUN echo "📂 Fichiers générés dans dist/src :" && ls -la dist/src && \
    if [ -f "dist/src/main.js" ]; then \
    echo "✅ Copie dist/src/main.js vers dist/main.js" && \
    cp dist/src/main.js dist/main.js; \
  else \
    echo "❌ dist/src/main.js introuvable, build échoué ?" && \
    ls -la dist/src/; \
  fi

# Vérification du build    
RUN echo "📂 Contenu du dossier dist après build:" && \
    ls -la dist/ && \
    if [ -d "dist/src" ]; then \
      echo "📂 Contenu du dossier dist/src après build:" && \
      ls -la dist/src/; \
    else \
      echo "⚠️ Le dossier dist/src n'existe pas!"; \
    fi && \
    if [ -f "dist/src/main.js" ]; then \
      echo "✅ main.js présent dans dist/src/, taille:" && \
      stat -c %s dist/src/main.js && \
      echo "🔍 Premières lignes de main.js:" && \
      head -n 20 dist/src/main.js; \
    else \
      echo "❌ main.js manquant dans dist/src/!" && \
      mkdir -p dist/src && \
      if [ -f "src/main.js" ]; then \
        echo "🔍 main.js trouvé dans src/, copie vers dist/src/..." && \
        cp src/main.js dist/src/main.js && \
        echo "✅ main.js copié depuis src/" && \
        stat -c %s dist/src/main.js; \
      else \
        echo "⚠️ main.js également manquant dans src/" && \
        npm run check:main-js && \
        if [ -f "dist/src/main.js" ]; then \
          echo "✅ main.js maintenant présent, taille:" && \
          stat -c %s dist/src/main.js; \
        else \
          echo "❌ main.js toujours manquant! Création d'un fichier fallback..." && \
          echo '"use strict";\nObject.defineProperty(exports, "__esModule", { value: true });\nconst express=require("express");\nconst app=express();\nconst cors=require("cors");\nconst PORT=process.env.PORT||3000;\napp.use(cors());\napp.get("/health",(req,res)=>res.send("ok"));\napp.get("/health/ping",(req,res)=>res.send("pong"));\napp.listen(PORT,()=>console.log(`Server running on port ${PORT}`));' > dist/src/main.js && \
          echo "✅ Fichier fallback créé"; \
        fi \
      fi \
    fi

# Créer script de secours server.js simple si nécessaire
RUN echo "/**\n * Serveur de secours simple pour Railway\n */\n\
const express = require('express');\n\
const app = express();\n\
const PORT = process.env.PORT || 3000;\n\
\n\
console.log('🚨 Démarrage du serveur de secours avec les variables:');\n\
console.log(`PORT: ${PORT}`);\n\
console.log(`NODE_ENV: ${process.env.NODE_ENV}`);\n\
console.log(`RAILWAY_DEPLOYMENT: ${process.env.RAILWAY_DEPLOYMENT}`);\n\
\n\
// CORS - Résout les problèmes de CORS pendant les tests\n\
app.use((req, res, next) => {\n\
  res.header('Access-Control-Allow-Origin', '*');\n\
  res.header('Access-Control-Allow-Methods', 'GET,PUT,POST,DELETE,OPTIONS');\n\
  res.header('Access-Control-Allow-Headers', 'Content-Type, Authorization');\n\
  if (req.method === 'OPTIONS') {\n\
    return res.sendStatus(200);\n\
  }\n\
  next();\n\
});\n\
\n\
// Routes de santé\n\
app.get('/health', (req, res) => {\n\
  res.json({ status: 'ok', message: 'Service en état de fonctionnement' });\n\
});\n\
\n\
app.get('/health/ping', (req, res) => {\n\
  res.json({ \n\
    status: 'ok', \n\
    message: 'pong',\n\
    timestamp: new Date().toISOString(),\n\
    environment: process.env.NODE_ENV,\n\
    railway: process.env.RAILWAY_DEPLOYMENT === 'true',\n\
    version: '1.0'\n\
  });\n\
});\n\
\n\
// Route d'API\n\
app.get('/', (req, res) => {\n\
  res.send('NionFar API Server');\n\
});\n\
\n\
app.get('/api', (req, res) => {\n\
  res.json({ message: 'API en mode secours' });\n\
});\n\
\n\
// Gestion des erreurs\n\
app.use((err, req, res, next) => {\n\
  console.error(err.stack);\n\
  res.status(500).json({ error: 'Erreur serveur' });\n\
});\n\
\n\
// Démarrer le serveur\n\
app.listen(PORT, '0.0.0.0', () => {\n\
  console.log(`🚀 Serveur de secours en écoute sur ${PORT}`);\n\
});\n\
\n\
// Gestion des erreurs process\n\
process.on('uncaughtException', (err) => {\n\
  console.error('Erreur non capturée:', err);\n\
});\n\
process.on('unhandledRejection', (reason) => {\n\
  console.error('Rejet non géré:', reason);\n\
});" > server.js && \
    chmod +x server.js

# Créer un script de démarrage simple avec correction de syntaxe
RUN echo '#!/bin/bash\n\
\n\
echo "🚀 Démarrage du serveur NionFar API..."\n\
echo "📝 Variables d'\''environnement configurées:"\n\
echo "- Frontend URL: $FRONTEND_URL"\n\
echo "- CORS autorisés: $CORS_ALLOWED_ORIGINS"\n\
echo "- Port: $PORT"\n\
echo "- Railway deployment: $RAILWAY_DEPLOYMENT"\n\
echo "- MongoDB URI configuré: $(if [ -n "$MONGODB_URI" ]; then echo "oui"; else echo "non"; fi)"\n\
\n\
echo "👉 Vérification du build..."\n\
echo "📂 Contenu du dossier dist/ :"\n\
ls -la dist/\n\
\n\
echo "🔄 DIAGNOSTIC PORT: La variable PORT est définie à: $PORT"\n\
if [ -z "$PORT" ]; then\n\
  echo "⚠️ ATTENTION: La variable PORT n'\''est pas définie! Utilisation du port par défaut 3000."\n\
  export PORT=3000\n\
else\n\
  echo "✅ PORT est correctement défini à $PORT"\n\
fi\n\
\n\
echo "✅ Version de NODE: $(node --version)"\n\
echo "✅ Version de NPM: $(npm --version)"\n\
\n\
# Vérifier les deux emplacements possibles pour main.js\n\
if [ ! -f "dist/main.js" ] && [ -f "dist/src/main.js" ]; then\n\
  echo "📦 main.js non trouvé à la racine, mais présent dans dist/src — tentative de copie..."\n\
  cp dist/src/main.js dist/main.js\n\
fi\n\
\n\
if [ -f "dist/main.js" ]; then\n\
  echo "✅ Démarrage de l'\''application principale..."\n\
  NODE_ENV=production RAILWAY_DEPLOYMENT=true IS_RENDER=false MEMORY_OPTIMIZED=true PORT="$PORT" node dist/main.js 2>&1 | tee logs/app.log || (\n\
    echo "❌ Échec du démarrage de l'\''application principale, examen des logs..."\n\
    tail -n 50 logs/app.log\n\
    echo "🔄 Utilisation du serveur de secours pour maintenir les healthchecks"\n\
    NODE_ENV=production RAILWAY_DEPLOYMENT=true IS_RENDER=false PORT="$PORT" node server.js\n\
  )\n\
else\n\
  echo "❌ main.js toujours manquant! Démarrage du serveur de secours..."\n\
  NODE_ENV=production RAILWAY_DEPLOYMENT=true IS_RENDER=false PORT="$PORT" node server.js\n\
fi' > start.sh && \
    chmod +x start.sh

# Créer le main.js manuellement pour s'assurer qu'il existe
RUN mkdir -p dist && \
    echo "// Fichier main.js créé manuellement pour garantir que le service démarre\n\
const express = require('express');\n\
const app = express();\n\
const PORT = process.env.PORT || 3000;\n\
\n\
console.log('🚨 Démarrage du serveur express fallback...', { port: PORT, env: process.env.NODE_ENV });\n\
\n\
// Configuration CORS\n\
app.use((req, res, next) => {\n\
  res.header('Access-Control-Allow-Origin', '*');\n\
  res.header('Access-Control-Allow-Methods', 'GET,PUT,POST,DELETE,OPTIONS');\n\
  res.header('Access-Control-Allow-Headers', 'Content-Type, Authorization');\n\
  \n\
  if (req.method === 'OPTIONS') {\n\
    return res.sendStatus(200);\n\
  }\n\
  \n\
  next();\n\
});\n\
\n\
// Logging middleware\n\
app.use((req, res, next) => {\n\
  console.log(`${new Date().toISOString()} - ${req.method} ${req.url}`);\n\
  next();\n\
});\n\
\n\
// Middleware pour gérer les options CORS\n\
app.use((req, res, next) => {\n\
  if (req.method === 'OPTIONS') {\n\
    console.log('OPTIONS request received');\n\
    res.header('Access-Control-Allow-Origin', '*');\n\
    res.header('Access-Control-Allow-Methods', 'GET,PUT,POST,DELETE,OPTIONS');\n\
    res.header('Access-Control-Allow-Headers', 'Content-Type, Authorization');\n\
    return res.sendStatus(200);\n\
  }\n\
  next();\n\
});\n\
\n\
// Healthcheck endpoint - Route publique (pas d'authentification requise)\n\
app.get('/health/ping', (req, res) => {\n\
  console.log('Health ping route requested');\n\
  res.json({ \n\
    status: 'ok', \n\
    message: 'pong',\n\
    timestamp: new Date().toISOString(),\n\
    environment: process.env.NODE_ENV,\n\
    railway: process.env.RAILWAY_DEPLOYMENT === 'true'\n\
  });\n\
});\n\
\n\
// Route racine pour Railway healthcheck\n\
app.get('/', (req, res) => {\n\
  console.log('Root route requested');\n\
  res.status(200).json({ \n\
    status: 'ok', \n\
    message: 'NionFar API is running',\n\
    timestamp: new Date().toISOString(),\n\
    mode: 'fallback'\n\
  });\n\
});\n\
\n\
// Regular health route\n\
app.get('/health', (req, res) => {\n\
  res.json({ status: 'ok' });\n\
});\n\
\n\
// API routes\n\
app.get('/api', (req, res) => {\n\
  res.json({ message: 'API is running in fallback mode' });\n\
});\n\
\n\
// Start server\n\
app.listen(PORT, '0.0.0.0', () => {\n\
  console.log(`🚀 Serveur express en écoute sur le port ${PORT}`);\n\
  console.log(`✅ Healthcheck disponible sur http://0.0.0.0:${PORT}/health/ping`);\n\
});\n\
\n\
// Error handling\n\
process.on('uncaughtException', (err) => {\n\
  console.error('Uncaught exception:', err);\n\
});\n\
\n\
process.on('unhandledRejection', (reason) => {\n\
  console.error('Unhandled rejection:', reason);\n\
});" > dist/main.js && \
    chmod +x dist/main.js

# Vérification finale des fichiers générés
RUN echo "📋 Vérification finale:" && \
    echo "📂 Contenu de dist/:" && \
    ls -la dist/ && \
    if [ -f "dist/main.js" ]; then \
      echo "✅ dist/main.js existe, taille:" && \
      stat -c %s dist/main.js; \
    else \
      echo "❌ ERREUR: dist/main.js toujours manquant!"; \
    fi

# Exposer le port (Railway réaffecte PORT via la variable d'environnement)
EXPOSE 3000 8080

# Utiliser dumb-init pour gérer correctement les signaux
ENTRYPOINT ["/usr/bin/dumb-init", "--"]

# Script de démarrage avec gestion des échecs
CMD ["./start.sh"] 