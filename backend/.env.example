# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=nionfar
DB_SYNC=false

# JWT
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your-jwt-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# 2FA
TWO_FACTOR_AUTHENTICATION_APP_NAME=NionFar

# Email
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=your-email@example.com
MAIL_PASSWORD=your-email-password
MAIL_FROM=noreply@example.com

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Payment (Wave)
WAVE_API_KEY=your-wave-api-key
WAVE_API_SECRET=your-wave-api-secret
WAVE_API_URL=https://api.wave.com

# Payment (Orange Money)
ORANGE_MONEY_API_KEY=your-orange-money-api-key
ORANGE_MONEY_API_SECRET=your-orange-money-api-secret
ORANGE_MONEY_API_URL=https://api.orange.com

# Payment (Free Money)
FREE_MONEY_API_KEY=your-free-money-api-key
FREE_MONEY_API_SECRET=your-free-money-api-secret
FREE_MONEY_API_URL=https://api.free-money.com 