# Application
NODE_ENV=development
PORT=8080
API_PREFIX=api
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Database (MongoDB)
MONGODB_URI=mongodb+srv://username:password@clusterexample.mongodb.net/database?retryWrites=true&w=majority
DB_AUTH_SOURCE=admin
DB_HOST=clusterexample.mongodb.net
DB_PORT=27017
DB_USERNAME=username
DB_DATABASE=database
DB_SYNC=false

# JWT
JWT_SECRET=your_secure_jwt_secret_here
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your_secure_refresh_token_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# Memory management
NODE_OPTIONS=--max-old-space-size=256
MAX_USERS_IN_MEMORY=100
MAX_TOKENS_IN_MEMORY=200
MEMORY_CHECK_INTERVAL_MS=60000
HEAP_WARNING_THRESHOLD=85
HEAP_CRITICAL_THRESHOLD=90
LOG_LEVEL=info

# Email (Resend)
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_SECURE=true
MAIL_USER=resend
MAIL_PASSWORD=your_resend_api_key_here
MAIL_FROM=example@yourdomain.com
MAIL_FROM_NAME=YourAppName
RESEND_API_KEY=your_resend_api_key_here
SENDGRID_API_KEY=your_sendgrid_api_key_here
USE_RESEND=true

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Services de paiement
WAVE_API_KEY=your-wave-api-key
ORANGE_MONEY_API_KEY=your-orange-money-api-key
FREE_MONEY_API_KEY=your-free-money-api-key

# 2FA
TWO_FACTOR_AUTHENTICATION_APP_NAME=NionFar

# Payment (Wave)
WAVE_API_SECRET=your-wave-api-secret
WAVE_API_URL=https://api.wave.com

# Payment (Orange Money)
ORANGE_MONEY_API_SECRET=your-orange-money-api-secret
ORANGE_MONEY_API_URL=https://api.orange.com

# Payment (Free Money)
FREE_MONEY_API_SECRET=your-free-money-api-secret
FREE_MONEY_API_URL=https://api.free-money.com

# Configuration MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# Options de sécurité supplémentaires
PASSWORD_SALT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Gestion de la mémoire et performances
NODE_OPTIONS="--max-old-space-size=1024"
MAX_USERS_IN_MEMORY=100
MAX_TOKENS_IN_MEMORY=200
MEMORY_CHECK_INTERVAL_MS=60000
HEAP_WARNING_THRESHOLD=85
HEAP_CRITICAL_THRESHOLD=90

# Module de performances
ENABLE_PERFORMANCE_MONITORING=true
MEMORY_MONITORING_INTERVAL=1800000
EXTERNAL_SERVICES_TO_MONITOR=[{"name":"Payment Gateway","url":"https://api.payment-provider.com/health","timeout":5000}]

# Variables minimales nécessaires au démarrage
MEMORY_OPTIMIZED=true

# Mode de déploiement
VERCEL=0 