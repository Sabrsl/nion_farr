{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "backend/src/main.ts", 
    "frontend/pages/**/*.{ts,tsx}",
    "frontend/components/**/*.{ts,tsx}"
  ],
  "project": [
    "backend/**/*.ts",
    "frontend/**/*.{ts,tsx}"
  ],
  "ignore": [
    "**/node_modules/**",
    "**/*.test.{ts,tsx}",
    "**/*.spec.{ts,tsx}",
    "**/*.d.ts",
    "**/dist/**",
    "**/build/**",
    "**/mocks/**",
    "**/tests/**"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "duplicateExports": "warn",
    "unlisted": "warn",
    "exports": "error",
    "types": "error",
    "files": "error",
    "dependencies": "warn",
    "devDependencies": "warn"
  }
} 